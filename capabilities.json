{
    "dataRoles": [
        {
            "displayName": "Rows",
            "name": "rows",
            "kind": "Grouping",
            "description": "The dimensions that define each row of the table."
        },
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Measure",
            "description": "The metrics or columns to display."
        },
        {
            "displayName": "Group by",
            "name": "groupBy",
            "kind": "Grouping",
            "description": "Optional field(s) to group and drill into rows. Multiple fields create nested groups."
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Grouping",
            "description": "Optional fields shown only when hovering a row."
        },
        {
            "displayName": "Permissions",
            "name": "permissions",
            "kind": "Measure",
            "description": "Optional viewer-access hint supplied by the report model. The visual may use this value to hide its own controls, but it does not replace Power BI security such as Row-Level Security (RLS), tenant policies, or host permissions."
        }
    ],
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "rows"
                            }
                        },
                        {
                            "for": {
                                "in": "groupBy"
                            }
                        },
                        {
                            "for": {
                                "in": "values"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        },
                        {
                            "for": {
                                "in": "permissions"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
